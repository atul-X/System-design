      "seed": 1792834126,
      "version": 525,
      "versionNonce": 1926849979,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761025370620,
      "link": null,
      "locked": false,
      "text": "Without primary node how all othere node end up coordinating  and which node is alive or dead and who own what  ?",
      "fontSize": 16,

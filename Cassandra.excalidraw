      "isDeleted": false,
      "boundElements": [],
      "updated": 1761025370620,
      "link": null,
      "locked": false,
      "text": "In cassandra there is no primary node and leader unlike othere database .\nEvery node is equal .any node  can be sever for read and write ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In cassandra there is no primary node and leader unlike othere database .\nEvery node is equal .any node  can be sever for read and write ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cQ8P_sbLSZpAP82JUjqxV",
      "type": "text",
      "x": -24.78278819668867,
      "y": 5197.325089987055,
      "width": 908.3356323242188,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",

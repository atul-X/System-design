      "text": "Table: Schema Definations\n                (Columns+type. but flexible)\n\nRow :Single record\n    (identified by primary key ,grouped for fast access)\n\nColumn = Name +Type+value\n    (rows can have different  columns- no nulls stored)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Table: Schema Definations\n                (Columns+type. but flexible)\n\nRow :Single record\n    (identified by primary key ,grouped for fast access)\n\nColumn = Name +Type+value\n    (rows can have different  columns- no nulls stored)",
      "autoResize": true,
      "lineHeight": 1.25

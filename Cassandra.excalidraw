      "seed": 136981522,
      "version": 368,
      "versionNonce": 470488475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761023565368,
      "link": null,
      "locked": false,
      "text": "Replication factor set at  keyspace level\nif rf is 3 then data is copied in 3 nodes of entier cluster. ",
